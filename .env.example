# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# FIREBASE CONFIGURATION:
# You can set these environment variables in your hosting provider (like Vercel)
# to connect your app to Firebase Firestore without needing a local configuration file.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_FIRESTORE_DATABASE_ID=""

# FIREBASE ADMIN SDK CONFIGURATION (server-side only, never exposed to browser):
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# GOOGLE APPS SCRIPT CONFIGURATION (server-side only, never exposed to browser):
# The Web App deployment URL and shared API secret for your Google Apps Script backend.
APPS_SCRIPT_URL=""
APPS_SCRIPT_SECRET=""

# GOOGLE MAPS PLATFORM CONFIGURATION:
# The API Key required to render Google Maps and locate service providers.
GOOGLE_MAPS_PLATFORM_KEY=""
VITE_GOOGLE_MAPS_PLATFORM_KEY=""

# PAYMENTS.LK PAYMENT GATEWAY CONFIGURATION:
# The secret API key (starts with sk_test_ for sandbox or sk_live_ for production)
# used for creating checkout sessions and verifying Mastercard / Visa card payments.
PAYMENTS_LK_SECRET_KEY=""
